# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# A direct, unpooled connection to that same database, used by
# `prisma migrate deploy` when the API is built on Vercel. Set it only if
# DATABASE_URL points at a pooler; POSTGRES_URL_NON_POOLING is read as a
# fallback. Locally there is nothing to set.
# DIRECT_DATABASE_URL=""

# A throwaway database for `bun run test`. The suite will not touch DATABASE_URL
# and refuses to run without this — these are real integration tests, they write
# and delete rows, and the pre-push hook runs them. The name has to end in
# `_test`. `bun run db:test` creates it and applies the migrations.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_test?schema=public"

# Generate your own:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Who is allowed to sign in — this is the entire authorisation model, so it has
# no default. Comma-separated, and each entry is either a whole email domain or
# a single address:
#
#   ALLOWED_SIGN_IN="acme.com"                       everyone at your company
#   ALLOWED_SIGN_IN="acme.com,contractor@gmail.com"  …plus one outsider
#   ALLOWED_SIGN_IN="you@gmail.com"                  a one-person install
#
# Subdomains count, so "acme.com" also admits "you@mail.acme.com".
ALLOWED_SIGN_IN=""

# Sign in with an email address and a password instead of an identity provider.
# Off unless this is exactly "1". It is the way in when you host this yourself
# and have no Google or Microsoft client, and it stands on the strength of your
# password alone, so pick a long one.
#
# Nobody can register: the form only signs in a user who already exists, and a
# password only exists once you set one:
#
#   printf '%s' 'your long password' | bun run --filter=api set-password you@example.com
#
# Setting it to "1" without setting a password leaves a form that refuses
# everybody, which is safe but useless.
# PASSWORD_SIGN_IN="1"

# Every pair below can also be typed on Settings → Connections instead, on a
# hosted install and on a self-hosted one. A value saved there is sealed in the
# database, it wins over the matching line here, and the API restarts itself so
# it reads the new value. Clear it there and the line here decides again.
#
# Google is the sign-in method a clone starts with, and the same client is what
# reads Gmail and Calendar. Set both or neither — half a pair is a sign-in
# button that fails at Google.
#
# Leave them empty only if you sign in with Microsoft below, or with your own
# identity provider added on Settings → SSO. With none of the three there is no
# way in at all, and the sign-in page says as much rather than showing you
# nothing.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft 365 / Entra ID — the other sign-in method, and the same app
# registration is what reads Outlook mail. Set both or neither, exactly like
# the Google pair.
#
# Create the app at https://portal.azure.com → Microsoft Entra ID → App
# registrations, add the redirect URI <API_URL>/api/auth/callback/microsoft,
# and give it the delegated Graph permissions User.Read and Mail.Read. The
# README has the full walkthrough.
#
# You can set Google and Microsoft together: the sign-in page offers both, and
# a rep's mail is read from whichever they signed in with.
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# Optional. Enables Slack account linking on Settings > Connections.
# Add API_URL + /api/auth/oauth2/callback/slack as the Slack OAuth redirect URL.
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""

# Which Entra tenant may sign in. "common" (the default) accepts any work,
# school or personal Microsoft account and leans on ALLOWED_SIGN_IN to decide
# who actually gets in; your own tenant's GUID refuses everyone else at
# Microsoft, before they ever reach us. "organizations" allows any work or
# school account but no personal ones.
# MICROSOFT_TENANT_ID="common"

# Serve the landing page at "/". It markets *this* product, so it is off unless
# you say otherwise: on an install of your own, a stranger arriving at the root
# is sent to /sign-in instead. The only value that turns it on is "true".
# IS_MARKETING="true"


# ── Where things are ─────────────────────────────────────────────────────────
# Only needed when you deploy. The defaults below are the localhost ones.

# The API. Also the origin that mints session cookies and serves /api/auth/*.
# API_URL="http://localhost:3001"

# The web app. Comma-separate if it is served from more than one origin —
# the first is canonical, and the rest are simply allowed to call the API.
# APP_URL="http://localhost:3000"

# Only when the API and the app are on different subdomains of one parent,
# e.g. api.example.com and app.example.com — then set ".example.com" so one
# session cookie covers both.
# AUTH_COOKIE_DOMAIN=""

# The research agent, which is its own deployment. The API reads this too, to
# tell the agent a logo or a photograph is waiting rather than letting it find
# out on its next minute.
# AGENT_URL="http://127.0.0.1:2000"

# Port used by the self-hosted Eve service. Hosted runtimes can keep injecting
# their standard PORT variable instead.
# AGENT_PORT="2000"

# Lets a signed-in rep talk to the agent from the contact sheet.
#
# The browser never calls the agent directly. The app proxies /eve/v1/* on its
# own origin, checks the session, and mints a two-minute token signed with this
# secret; the agent verifies it and learns *which rep* is asking. Set the same
# value for both processes.  openssl rand -base64 32
#
# It also authorises two calls the API makes to the agent: the dispatch poke,
# which is what makes a new company's logo appear as it is added instead of on
# the next minute's tick, and the check that a model provider key is real
# before it is saved.
#
# Leave it unset and the Agent tab reports that it is not configured, the poke
# is skipped rather than sent unauthenticated, and a provider key is saved
# without being checked. Nothing else changes: the agent still runs on its own
# schedule.
# AGENT_BRIDGE_SECRET=""

# When the updater looks for a new release, as a six field cron with seconds.
# Docker only, and only with the "updater" profile. Empty means it never looks
# on its own and only the button in Settings updates the install, which is the
# right default for a self-hoster who wants to choose the moment.
#
# A hosted install sets it, so a customer never updates anything. Give the
# operator's own install an earlier slot than the customers, so a bad release
# breaks the operator first:
#   the operator   UPDATER_SCHEDULE="0 0 4 * * *"
#   the customers  UPDATER_SCHEDULE="0 0 5 * * *"
# UPDATER_SCHEDULE=""

# Which Docker API version the updater speaks. The updater is watchtower 1.7.1,
# which asks for API 1.25 on its own, and Docker 29 refuses anything below 1.40.
# The updater then restarts forever and no release ever arrives. 1.44 works
# with Docker 25 and every newer engine. Set it lower only on an older Docker.
# UPDATER_DOCKER_API="1.44"

# How much memory the agent may hold, in MB. Docker only. Empty is the default
# and means no cap, which is the only setting measured safe under load.
#
# Node takes what the machine offers and gives none of it back, so an idle
# agent was measured holding 3.9 GB on a 24 GB server with an empty database.
# A cap looks like free money and is not: the same agent working through 1190
# queued tasks died every 20 seconds at 1024, and again at 512. It needs the
# room while it reads a mail thread.
#
# Set it only on a host that must fit more installs than it has memory for,
# and only after watching the agent work through a real backlog without a
# restart. `docker inspect reloop-agent-1 --format "{{.RestartCount}}"` is the
# number that tells you. Anything above zero means the cap is too low.
# AGENT_HEAP_MB=""

# Where the agent keeps the Codex login for the ChatGPT subscription path, and
# where it downloads the Codex command line on the first sign-in. Defaults to
# ~/.codex. The Docker image sets it to /data/codex, a volume.
# CODEX_HOME=""

# PORT="3001"


# ── Optional: what the agent can do ──────────────────────────────────────────
# The research agent works with none of these — it falls back to what the CRM
# already knows (your own email and calendar history) and simply reports what
# it could not check. Each key you add unlocks one more place it can look, and
# it tells you at startup which ones are on.

# Perplexity — finds where a person lives on the web, and recent news worth
# knowing before a call. https://perplexity.ai/settings/api
# PERPLEXITY_API_KEY=""

# TypeSafe — an optional cheap first read of a mail conversation. Before the
# expensive model classifies a conversation, Jev answers one yes or no question:
# is this about your business. A clear no skips the expensive read, which is
# where the saving is. Without a key nothing changes and every conversation gets
# the expensive read. A key saved in Settings, AI wins over this one.
# Only the agent reads it. https://typesafe.ai
# TYPESAFE_API_KEY=""

# GitHub — raises the rate limit when matching contacts to GitHub profiles.
# Any classic token with no scopes will do.
# GITHUB_TOKEN=""

# Vercel Blob — where every logo and profile picture in the CRM is kept.
#
# The URLs these arrive on are somebody else's: LinkedIn signs theirs with an
# expiry a few weeks out, a brand CDN is a rate limit on a page that draws forty
# logos, and a company's own favicon is served by a company with no idea we are
# drawing it. So the bytes are copied once and the record points at our copy.
#
# Read by the agent, by the API — which writes a favicon and a signed-in user's
# Google avatar — and by the seed. Not by the Next.js app, which only needs to
# recognise one of our URLs to route it through the image optimizer.
#
# Without it, a contact's photograph is not stored at all, because a URL that
# works today and 404s next month is worse than initials and nobody can tell
# which it will be. Everything else — logos, favicons, avatars — keeps the
# origin's URL and renders as an ordinary hotlinked image.
# BLOB_READ_WRITE_TOKEN=""

# OpenRouter pays for the model when nobody pasted an OpenAI or Anthropic key
# and nobody signed in with a ChatGPT subscription. The key is normally pasted
# on Settings → AI and stored sealed in the database; this variable is the
# same key for an install that keeps every secret in the environment. A key in
# the database wins over this one. Which model is a setting, not a variable.
# https://openrouter.ai/keys
# In hosted mode this key is the operator's: every plan with AI included runs
# on it, and a key a customer pastes in Settings is not read.
# OPENROUTER_API_KEY=""


# ── Optional: operations ─────────────────────────────────────────────────────

# Shared cache. Without it each instance caches in its own memory, which is
# correct — just not shared. Recommended in production once website tracking is
# on: the compiled tracking config, the collector's rate limit and the hourly
# cap on contacts created from forms are all counted here, and per-instance
# counters let a multi-instance deployment exceed both.
# REDIS_URL="redis://localhost:6379"
# CACHE_TTL_MS="60000"

# Run the mailbox sync (Gmail, Outlook, IMAP) inside the API on a timer, every
# this many milliseconds. For a self-hosted install with no external scheduler.
# Leave it unset on Vercel, where the cron calls POST /internal/sync/mailboxes.
# MAILBOX_SYNC_INTERVAL_MS="60000"

# Bearer token guarding POST /internal/sync/google, the Gmail/Calendar cron
# route, and POST /internal/tracking/retention, the nightly sweep that deletes
# tracked page views older than 90 days. Both refuse to run without it. At
# least 16 characters.
# CRON_SECRET=""

# Log every SQL statement Prisma runs, at debug level, without bound
# parameters. Off by default: it buries every other line under a wall of
# SELECTs.
# PRISMA_LOG_QUERIES="true"


# ── Anonymous usage telemetry ────────────────────────────────────────────────
# This repo is MIT and cloned rather than installed, so there is no download
# count and no runtime signal. Once a day the API sends one event of counts —
# how many contacts exist in bands rather than exactly, which of the agent's
# tools were called, how the evidence ledger behaved, which optional keys are
# set as booleans — tied to a random UUID generated by the first migration.
#
# It is server-side only. There is no posthog-js anywhere, no autocapture and
# no session replay, because autocapture on a CRM would lift contact names and
# deal amounts out of your database. No name, address, company, subject line,
# amount, prompt or key is ever sent, and neither is your IP: every event
# carries $ip: null with geoip off.
#
# docs/telemetry.md names every event and every property that is sent, and
# lists what never is.

# Turn it off. "1" is the whole interface, and DO_NOT_TRACK=1 does the same.
# When either is set no client is created, so nothing can be sent later.
#
# CRM_TELEMETRY_DISABLED="1"

# Where it goes. Without POSTHOG_KEY no client is ever created and nothing can
# be sent, which is what a self-hosted install gets by default. Set it to the
# write-only project key of your own PostHog project if you want the numbers.
# A phc_ key sends events and reads nothing back, so it is a public identifier
# and not a secret. The two hosts only need changing for a self-hosted PostHog
# or for the US cloud.
# POSTHOG_KEY="phc_your_write_only_project_key"
# POSTHOG_HOST="https://eu.i.posthog.com"
# POSTHOG_UI_HOST="https://eu.posthog.com"


# ── Optional: language ───────────────────────────────────────────────────────

# The app speaks seven languages and every person picks one in Settings > General,
# so the app reads no variable. This one is left for the agent only: with the
# literal "true" the agent writes its notes and summaries in German. It reaches
# the agent when you run from source. The agent container in
# deploy/docker-compose.yml does not receive it.
# RELOOP_GERMAN="true"


# ── Optional: update check ───────────────────────────────────────────────────

# Settings shows the version you run and whether a newer release exists. The
# API asks the public GitHub releases endpoint once every six hours, with no
# token and nothing about your install. The only value that turns it off is
# "false"; then Settings shows the version alone.
# RELOOP_UPDATE_CHECK="false"

# The Update button in Settings. The Docker install runs a separate updater
# container (watchtower) behind the compose profile "updater". The API posts to
# it with this token, and the updater pulls the images and restarts the Reloop
# containers. install.sh writes the token; the profile stays off until
# COMPOSE_PROFILES lists "updater". Without the token, or with the updater off,
# Settings shows the command only. UPDATER_URL defaults to http://updater:8080.
# UPDATER_TOKEN=""
# UPDATER_URL="http://updater:8080"


# ── Self-host timers ─────────────────────────────────────────────────────────

# Set by Vercel itself, never by hand. When it is set the API starts no
# in-process timers, because Vercel crons call the sync routes. Without it a
# production API refreshes exchange rates once a day and runs the mailbox sync
# every MAILBOX_SYNC_INTERVAL_MS. The Docker install sets its own values in
# deploy/.env, written by install.sh. docs/self-host.md explains that file.
# VERCEL="1"

# NEXT_DIST_DIR=".next-build"   build the app into another folder
#
# Only for a deploy that must stay online while it builds: build into this
# folder, then rename it to .next and restart. Leave it unset everywhere else.
# The Docker images set it to .next themselves.

# RELOOP_PLANS="true"          show the Plan card in Settings
#
# Only the operator of a hosted install needs it. It shows the limits card in
# Settings. A self-hosted install has no plan and no limits, so leave it unset.

# RELOOP_MANAGED="true"        an operator keeps this install up to date
#
# For the hosted Cloud and for a server that runs from source under systemd.
# The Version card then shows the version and the state only: no update
# command, no Update button. system.update refuses. A Docker install leaves it
# unset.

# RELOOP_DEMO="true"           show the Play demo button in the app
#
# Only for recording a product video. The button plays a scripted tour of the
# real app with a fake cursor. A normal install never needs it, so leave it unset.

# ── Hosted mode: one database per customer ───────────────────────────────────

# Only the operator of Reloop Cloud sets these two. A self-hosted install leaves
# both unset and runs as one workspace on DATABASE_URL, exactly as before.
#
# RELOOP_REGISTRY_URL is a small Postgres database that lists every customer
# (tenant): who they are, which database holds their CRM, and which sign-in
# domains and tracking site ids belong to them. With it set the API resolves the
# tenant on every request, from the API key prefix, the crm.tenant cookie or the
# tracking site id, and answers 401 TENANT_REQUIRED without one. ALLOWED_SIGN_IN
# is then read from the registry per tenant and the line above is ignored.
# RELOOP_REGISTRY_URL="postgresql://postgres:postgres@localhost:5432/reloop_registry"

# How a tenant's database URL is built from its database name. {db} is replaced
# with the name stored in the registry. Required when RELOOP_REGISTRY_URL is set.
# RELOOP_TENANT_DATABASE_URL_TEMPLATE="postgresql://postgres:postgres@localhost:5432/{db}"

# Where a tenant's database is dumped before it is dropped: a trial that stayed
# suspended for 30 days, or `bun scripts/tenant.ts delete`. pg_dump on PATH
# writes the dump; without it, a nightly dump of that database in this folder
# younger than 36 hours counts (deploy/cloud/backup.sh writes them). With
# neither, the daily sweep keeps the tenant suspended and logs it, and the CLI
# refuses to delete. Only read in hosted mode.
# RELOOP_BACKUP_DIR="/var/backups/reloop"

# The nightly backup in deploy/cloud/backup.sh copies every dump to this rclone
# remote (`<remote>:<path>`). Unset, the dumps stay on the host only and the
# script prints a warning. Only the backup container reads it.
# RELOOP_BACKUP_REMOTE="offsite:reloop-backups"

# GOOGLE_SITE_VERIFICATION=""   prove the site to Google Search Console
#
# Only for a public install. Search Console gives you a token for the HTML tag
# method. Paste the token itself, without the meta tag around it. Leave it
# empty and no tag is written.

# ORG_CONTACT_EMAIL=""          the support address in the Organization JSON-LD
# ORG_CONTACT_PHONE=""          the support phone number in the same block
#
# Only for a public install. Search engines read the Organization block on the
# public site. Set either one, both, or neither. Each missing value drops its
# own field, and with both unset no contact point is written at all.

# ORG_STREET_ADDRESS=""         street and number of the registered address
# ORG_POSTAL_CODE=""            postal code of the same address
# ORG_ADDRESS_LOCALITY=""       city or town of the same address
# ORG_ADDRESS_COUNTRY=""        country of the same address, as a name or an ISO code
#
# Only for a public install, and only where an imprint law asks for it. Each
# one is optional and drops its own field. With all four unset no address is
# written. A value longer than 200 characters is ignored.
