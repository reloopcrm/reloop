{
	"name": "api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "MIT",
	"exports": {
		"./app-router": "./src/generated/server.ts"
	},
	"scripts": {
		"build": "bun build src/main.ts --target=bun --outdir dist --packages=external --splitting --format=esm --sourcemap",
		"check-types": "tsc --noEmit",
		"dev": "concurrently -n api,trpc -c blue,magenta \"bun scripts/dev.ts\" \"bun run dev:trpc\"",
		"dev:trpc": "nestjs-trpc watch -e src/app.module.ts -r \"**/*.router.ts\" -o src/generated",
		"dev:session": "bun scripts/dev-session.ts",
		"set-password": "bun scripts/set-password.ts",
		"lint": "biome check .",
		"postinstall": "node scripts/chmod-trpc-binary.mjs",
		"start": "bun run build && bun run start:prod",
		"start:prod": "bun dist/main.js",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"trpc:generate": "nestjs-trpc generate -e src/app.module.ts -r \"**/*.router.ts\" -o src/generated",
		"clean": "rm -rf .turbo dist node_modules src/generated",
		"test:security": "bun scripts/test-security.ts"
	},
	"dependencies": {
		"@crm/auth": "workspace:*",
		"@crm/db": "workspace:*",
		"@crm/env": "workspace:*",
		"@crm/telemetry": "workspace:*",
		"@crm/validation": "workspace:*",
		"@keyv/redis": "^5.1.6",
		"@nestjs/cache-manager": "^3.1.3",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/swagger": "^11.4.7",
		"@thallesp/nestjs-better-auth": "^2.7.0",
		"@trpc/server": "^11.18.0",
		"@vercel/blob": "^2.6.1",
		"better-auth": "^1.6.25",
		"cache-manager": "^7.2.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"imapflow": "^2.0.0",
		"mailparser": "^3.9.23",
		"nestjs-trpc": "^2.13.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"stripe": "^22.6.2",
		"trpc-to-openapi": "^3.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@nestjs/testing": "^11.0.1",
		"@types/bun": "^1.3.14",
		"@types/express": "^5.0.0",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.0.0",
		"concurrently": "^9.1.0",
		"supertest": "^7.0.0",
		"typescript": "^5.9.2"
	}
}
