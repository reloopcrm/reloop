{
	"name": "@crm/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./agent-tasks": "./src/agent-tasks.ts",
		"./attribution": "./src/attribution.ts",
		"./blob": "./src/blob.ts",
		"./client": "./src/client.ts",
		"./currency": "./src/currency.ts",
		"./crm-events": "./src/crm-events.ts",
		"./deal-stage": "./src/deal-stage.ts",
		"./enums": "./src/generated/prisma/enums.ts",
		"./favicon": "./src/favicon.ts",
		"./fields": "./src/fields.ts",
		"./fields-shape": "./src/fields-shape.ts",
		"./fx": "./src/fx.ts",
		"./http": "./src/http.ts",
		"./images": "./src/images.ts",
		"./insights": "./src/insights.ts",
		"./idempotency": "./src/idempotency.ts",
		"./json": "./src/json.ts",
		"./locale": "./src/locale.ts",
		"./contact-standing": "./src/contact-standing.ts",
		"./contact-worth": "./src/contact-worth.ts",
		"./message-text": "./src/message-text.ts",
		"./model-prices": "./src/model-prices.ts",
		"./model-spend": "./src/model-spend.ts",
		"./provider-usage": "./src/provider-usage.ts",
		"./quote-deals": "./src/quote-deals.ts",
		"./reactivation": "./src/reactivation.ts",
		"./win-back-outcome": "./src/win-back-outcome.ts",
		"./win-back-rules": "./src/win-back-rules.ts",
		"./safe-fetch": "./src/safe-fetch.ts",
		"./sample-data": "./src/sample-data.ts",
		"./secrets": "./src/secrets.ts",
		"./plans": "./src/plans.ts",
		"./settings": "./src/settings.ts",
		"./test-database": "./src/test-database.ts",
		"./slack-inventory": "./src/slack-inventory.ts",
		"./tracking": "./src/tracking.ts",
		"./webhooks": "./src/webhooks.ts",
		"./workspace": "./src/workspace.ts"
	},
	"scripts": {
		"build": "prisma generate",
		"check-types": "tsc --noEmit",
		"db:deploy": "prisma migrate deploy",
		"db:generate": "prisma generate",
		"db:migrate": "bun scripts/require-local-db.ts db:migrate && prisma migrate dev",
		"db:push": "bun scripts/require-local-db.ts db:push && prisma db push",
		"db:reset": "bun scripts/require-local-db.ts db:reset && prisma migrate reset",
		"db:seed": "bun scripts/require-local-db.ts db:seed && prisma db seed",
		"db:studio": "prisma studio",
		"db:test": "bun scripts/test-db.ts",
		"test": "bun test",
		"dev:prepare": "bun scripts/prepare-dev.ts",
		"lint": "biome check .",
		"postinstall": "prisma generate",
		"clean": "rm -rf .turbo node_modules src/generated"
	},
	"dependencies": {
		"@crm/env": "workspace:*",
		"@crm/typescript-config": "workspace:*",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@vercel/blob": "^2.6.1",
		"prisma": "^7.9.1"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"pg": "^8.22.0",
		"typescript": "5.9.2"
	}
}
